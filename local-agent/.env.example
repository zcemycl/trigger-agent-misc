GITHUB_REPO=OWNER/REPOSITORY
BASE_BRANCH=main
SOURCE_REPO=/home/USER/src/REPOSITORY
WORKSPACE_ROOT=/home/USER/local-agent/workspaces
POLL_INTERVAL=60
MAX_CONCURRENT_TASKS=1
AGENT_COMMAND=agent
AGENT_TIMEOUT=1800
TEST_COMMAND=pytest -q
TRUSTED_GITHUB_USERS=your-github-login
DATABASE_PATH=/home/USER/local-agent/.agent_data/agent.db
LOG_DIR=/home/USER/local-agent/.agent_data/logs
FEEDBACK_BATCH_SECONDS=15
MAX_AGENT_RETRIES=2
COMMIT_MESSAGE_PREFIX=agent:
# Use COMMIT_GIT_* (not GIT_AUTHOR_*) so empty dotenv values cannot break git rebase.
COMMIT_GIT_AUTHOR_NAME=local-agent
COMMIT_GIT_AUTHOR_EMAIL=local-agent[bot]@users.noreply.github.com
# Optional; defaults to COMMIT_GIT_AUTHOR_* when empty — omit rather than set blank.
# COMMIT_GIT_COMMITTER_NAME=
# COMMIT_GIT_COMMITTER_EMAIL=
# Leave empty to disable the trailer
COMMIT_CO_AUTHORED_BY=local-agent <local-agent[bot]@users.noreply.github.com>
